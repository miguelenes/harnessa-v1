---
import BaseLayout from "../layouts/BaseLayout.astro";

const portalUrl = "https://app.harnessa.cloud";
const repositoryUrl = "https://github.com/miguelenes/harnessa-v1";
const docsUrl = "https://docs.harnessa.cloud";
const flow = [
  { number: "01", title: "Make the scope explicit", body: "Start from a clear request, a repository, and the boundaries the work must respect." },
  { number: "02", title: "Keep execution legible", body: "Design every run to leave a useful trail of decisions, changes, and evidence." },
  { number: "03", title: "Verify the result", body: "Make checks and review part of the path from a proposed change to a finished one." },
];
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Harnessa home">
        <svg class="brand-mark" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path d="M13 8H8v20h5M23 8h5v20h-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          <path d="m14 21 4-6 4 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="18" cy="25" r="1.5" fill="currentColor" />
        </svg>
        <span>harnessa</span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#approach">Approach</a>
        <a href="#workflow">Workflow</a>
        <a href={repositoryUrl}>Open source <span aria-hidden="true">↗</span></a>
        <a class="nav-portal" href={portalUrl}>Cloud preview <span aria-hidden="true">↗</span></a>
      </nav>
      <a class="header-cta" href={portalUrl}>Open preview <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main">
    <section class="hero section-wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-dot"></span> A more considered way to build with agents</div>
        <h1 id="hero-title">Agentic engineering,<br /><span>kept in the loop.</span></h1>
        <p class="hero-lede">A workspace in development for teams who want agent work to stay scoped, observable, and reviewable.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={portalUrl}>Explore the cloud preview <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="#approach">How Harnessa works <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-note"><span class="note-line"></span><span>Building the foundations for reviewable agent work.</span></div>
      </div>

      <div class="preview-frame" aria-label="Illustrative Harnessa workflow preview">
        <div class="preview-topbar">
          <div class="preview-crumb"><span class="mini-mark">h</span><span>agent-workspace</span><span class="crumb-slash">/</span><span>review flow</span></div>
          <span class="design-tag"><span class="tag-dot"></span> DESIGN PREVIEW</span>
        </div>
        <div class="preview-content">
          <div class="flow-rail" aria-label="Illustrative workflow: intent, run, verify, review">
            <div class="flow-step is-done"><span class="step-icon">✓</span><div><small>01 · INTENT</small><strong>Scope defined</strong></div></div>
            <span class="flow-connector done" aria-hidden="true"></span>
            <div class="flow-step is-active"><span class="step-icon active-mark">02</span><div><small>02 · RUN</small><strong>Work in progress</strong></div></div>
            <span class="flow-connector" aria-hidden="true"></span>
            <div class="flow-step"><span class="step-icon">03</span><div><small>03 · VERIFY</small><strong>Checks to come</strong></div></div>
            <span class="flow-connector" aria-hidden="true"></span>
            <div class="flow-step"><span class="step-icon">04</span><div><small>04 · REVIEW</small><strong>Human decision</strong></div></div>
          </div>
          <div class="artifact-row">
            <div class="artifact-card">
              <div class="artifact-heading"><span class="file-icon" aria-hidden="true">⌘</span><div><strong>change-summary.md</strong><small>Review artifact · draft</small></div><span class="artifact-menu" aria-hidden="true">•••</span></div>
              <div class="code-lines" aria-hidden="true">
                <div><i>01</i><span class="code-purple">##</span> Add explicit task boundaries</div>
                <div><i>02</i><span class="code-green">+</span> Scope is recorded before execution</div>
                <div><i>03</i><span class="code-green">+</span> Verification remains attached</div>
                <div><i>04</i><span class="code-muted">↳</span> Human review required before shipping</div>
              </div>
              <div class="artifact-foot"><span><b class="status-dot"></b> Awaiting verification</span><code>REVISION · DRAFT</code></div>
            </div>
            <div class="event-card">
              <div class="event-title"><span>Run timeline</span><span class="event-live"><b></b> PREVIEW</span></div>
              <div class="event-item"><span class="event-mark done">✓</span><div><strong>Scope recorded</strong><small>Intent and limits attached</small></div></div>
              <div class="event-item"><span class="event-mark active">·</span><div><strong>Implementation</strong><small>Evidence is being collected</small></div></div>
              <div class="event-item future"><span class="event-mark">3</span><div><strong>Verification</strong><small>Next in the flow</small></div></div>
              <div class="event-item future"><span class="event-mark">4</span><div><strong>Review</strong><small>Decision stays with you</small></div></div>
            </div>
          </div>
        </div>
        <div class="preview-caption"><span>Conceptual product view</span><span>No live workspace data</span></div>
      </div>
    </section>

    <section class="status-band" aria-label="Product availability">
      <div class="status-inner"><span class="status-label"><span class="status-dot"></span> IN DEVELOPMENT</span><span class="status-divider"></span><span>Hosted preview shell</span><span class="status-divider"></span><span>Core workflows in progress</span><a href={portalUrl}>See the current cloud preview <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="approach section-wrap" id="approach" aria-labelledby="approach-title">
      <div class="section-heading">
        <div><span class="section-kicker">A different kind of control plane</span><h2 id="approach-title">The work should be<br />as clear as the outcome.</h2></div>
        <p>Harnessa is being designed to bring intent, execution, and evidence into the same reviewable path—so automation can move quickly without making the work opaque.</p>
      </div>
      <div class="principles-grid">
        <article class="principle-card">
          <div class="principle-number">01 <span aria-hidden="true">↗</span></div>
          <div class="principle-icon scope-icon" aria-hidden="true"><span></span><span></span><span></span></div>
          <h3>Keep scope explicit</h3>
          <p>Start with the task, repository, and boundaries in view. Make the working agreement part of the record.</p>
          <div class="principle-rule"></div><small>INTENT BEFORE EXECUTION</small>
        </article>
        <article class="principle-card">
          <div class="principle-number">02 <span aria-hidden="true">↗</span></div>
          <div class="principle-icon trail-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <h3>See what changed</h3>
          <p>Follow a run through its decisions and artifacts. Keep useful evidence close to the code it describes.</p>
          <div class="principle-rule"></div><small>ACTIVITY WITH PROVENANCE</small>
        </article>
        <article class="principle-card">
          <div class="principle-number">03 <span aria-hidden="true">↗</span></div>
          <div class="principle-icon review-icon" aria-hidden="true"><span class="review-check">✓</span><span></span></div>
          <h3>Review before it ships</h3>
          <p>Make verification and human judgment visible steps. A finished task should have a legible reason to trust it.</p>
          <div class="principle-rule"></div><small>EVIDENCE BEFORE ACCEPTANCE</small>
        </article>
      </div>
    </section>

    <section class="workflow-section" id="workflow" aria-labelledby="workflow-title">
      <div class="workflow-inner section-wrap">
        <div class="workflow-intro"><span class="section-kicker">Designed for a complete loop</span><h2 id="workflow-title">From first question<br />to reviewed change.</h2><p>The product is under active development. This is the workflow Harnessa is being built to support.</p></div>
        <ol class="workflow-list">
          {flow.map((item) => (
            <li class="workflow-item">
              <span class="workflow-num">{item.number}</span>
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
              <span class="workflow-arrow" aria-hidden="true">↗</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="closing section-wrap">
      <div class="closing-copy"><span class="section-kicker">Start with what is real</span><h2>See the foundation<br />taking shape.</h2><p>Explore the static cloud portal preview and follow the product foundation as it develops.</p></div>
      <a class="closing-link" href={portalUrl}><span><small>HARNESA CLOUD</small><strong>Open the preview</strong></span><span class="closing-arrow" aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <a class="brand footer-brand" href="/" aria-label="Harnessa home"><svg class="brand-mark" viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M13 8H8v20h5M23 8h5v20h-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /><path d="m14 21 4-6 4 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><circle cx="18" cy="25" r="1.5" fill="currentColor" /></svg><span>harnessa</span></a>
      <p>Agentic engineering, with the work in view.</p>
      <nav aria-label="Footer navigation"><a href="#approach">Design principles</a><a href={repositoryUrl}>GitHub <span aria-hidden="true">↗</span></a><a href={docsUrl}>Documentation <span aria-hidden="true">↗</span></a><a href={portalUrl}>Cloud preview <span aria-hidden="true">↗</span></a></nav>
      <small>© {new Date().getFullYear()} Harnessa · Product in development</small>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(*) { box-sizing: border-box; }
  .skip-link { position: absolute; z-index: 20; top: 8px; left: 8px; padding: 10px 14px; transform: translateY(-150%); border-radius: 8px; background: var(--foreground); color: var(--background); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: sticky; z-index: 10; top: 0; border-bottom: 1px solid rgb(217 222 224 / 75%); background: rgb(245 246 244 / 92%); backdrop-filter: blur(14px); }
  .header-inner,.section-wrap,.footer-inner,.status-inner { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .header-inner { display: flex; height: 76px; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 9px; color: var(--foreground); font-size: 20px; font-weight: 720; letter-spacing: -1.1px; text-decoration: none; }
  .brand-mark { width: 34px; height: 34px; color: var(--primary); }
  .main-nav,.main-nav a { display: flex; align-items: center; }
  .main-nav { gap: 34px; }
  .main-nav a,.site-footer nav a { gap: 6px; color: #505b65; font-size: 13px; font-weight: 550; text-decoration: none; transition: color .18s; }
  .main-nav a:hover,.site-footer nav a:hover { color: var(--primary); }
  .nav-portal { display: none !important; }
  .header-cta { display: inline-flex; min-height: 40px; align-items: center; gap: 11px; padding: 0 15px; border: 1px solid var(--border); border-radius: 8px; color: var(--foreground); font-size: 12px; font-weight: 640; text-decoration: none; transition: .18s ease; }
  .header-cta:hover { border-color: var(--primary); color: var(--primary); }
  .hero { display: grid; min-height: 648px; grid-template-columns: .88fr 1.12fr; align-items: center; gap: 60px; padding-block: 83px 88px; }
  .hero-copy { padding-block: 10px 0; }
  .eyebrow,.section-kicker { display: flex; align-items: center; gap: 9px; color: #56616b; font-size: 11px; font-weight: 680; letter-spacing: .105em; text-transform: uppercase; }
  .eyebrow-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px #dcefeb; }
  h1,h2,h3,p { margin-top: 0; }
  .hero h1 { margin: 28px 0 22px; color: var(--foreground); font-size: clamp(46px, 5vw, 65px); font-weight: 650; letter-spacing: -.065em; line-height: 1.04; }
  .hero h1 span { color: var(--primary); }
  .hero-lede { max-width: 455px; margin-bottom: 31px; color: #59636d; font-size: 17px; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 11px; }
  .button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; gap: 13px; padding: 0 17px; border: 1px solid transparent; border-radius: 9px; font-size: 12px; font-weight: 650; text-decoration: none; transition: transform .18s ease, background .18s ease, border-color .18s ease; }
  .button:hover { transform: translateY(-1px); }
  .button-primary { background: var(--primary); color: #fff; box-shadow: 0 3px 8px rgb(81 70 229 / 17%); }
  .button-primary:hover { background: #4035d0; }
  .button-secondary { border-color: var(--border); background: transparent; color: var(--foreground); }
  .button-secondary:hover { border-color: #a8a0fc; background: #eeedff; }
  .hero-note { display: flex; align-items: center; gap: 10px; margin-top: 43px; color: #69737c; font-size: 11px; }
  .note-line { width: 26px; height: 1px; background: #a5afb4; }
  .preview-frame { overflow: hidden; border: 1px solid #dce1e2; border-radius: 15px; background: #fcfdfc; box-shadow: 0 26px 60px rgb(20 30 39 / 8%), 0 4px 14px rgb(20 30 39 / 4%); transform: translateY(7px); }
  .preview-topbar { display: flex; min-height: 53px; align-items: center; justify-content: space-between; padding-inline: 17px; border-bottom: 1px solid #e5e9e8; background: #fff; }
  .preview-crumb { display: flex; align-items: center; gap: 9px; color: #67717a; font-family: var(--font-mono); font-size: 9px; }
  .preview-crumb span:last-child { color: #28323b; }
  .mini-mark { display: grid; width: 18px; height: 18px; place-items: center; border-radius: 5px; background: #eae9ff; color: var(--primary); font-family: var(--font-sans); font-size: 11px; font-weight: 750; }
  .crumb-slash { color: #a1a8ac; }
  .design-tag { display: inline-flex; align-items: center; gap: 6px; padding: 5px 7px; border: 1px solid #e1e5e5; border-radius: 5px; color: #777f84; font-size: 7px; font-weight: 700; letter-spacing: .09em; }
  .tag-dot { width: 5px; height: 5px; border-radius: 50%; background: #8a80f2; }
  .preview-content { padding: 22px 20px 18px; }
  .flow-rail { display: flex; align-items: center; margin-bottom: 20px; }
  .flow-step { display: flex; min-width: 104px; align-items: center; gap: 8px; }
  .step-icon { display: grid; width: 23px; height: 23px; flex: 0 0 23px; place-items: center; border: 1px solid #dce1e1; border-radius: 7px; background: #fff; color: #929aa0; font-family: var(--font-mono); font-size: 9px; }
  .is-done .step-icon { border-color: #c4e3d7; background: #edf8f3; color: #147950; font-size: 11px; }
  .active-mark { border-color: #b8b2ff; background: #f0efff; color: var(--primary); }
  .flow-step div { display: flex; flex-direction: column; gap: 4px; white-space: nowrap; }
  .flow-step small { color: #899198; font-family: var(--font-mono); font-size: 7px; letter-spacing: .035em; }
  .flow-step strong { color: #34404a; font-size: 8px; font-weight: 650; }
  .flow-step:not(.is-done):not(.is-active) strong { color: #899198; font-weight: 520; }
  .flow-connector { height: 1px; min-width: 14px; flex: 1 1 auto; margin: 0 7px; background: #dce1e1; }
  .flow-connector.done { background: #9bcdb7; }
  .artifact-row { display: grid; grid-template-columns: 1.35fr .83fr; gap: 12px; }
  .artifact-card,.event-card { min-width: 0; overflow: hidden; border: 1px solid #e1e6e5; border-radius: 9px; background: #fff; }
  .artifact-heading { display: flex; min-height: 52px; align-items: center; gap: 9px; padding-inline: 11px; border-bottom: 1px solid #eef0ef; }
  .file-icon { display: grid; width: 25px; height: 25px; place-items: center; border-radius: 6px; background: #f0efff; color: #554be0; font-size: 12px; }
  .artifact-heading div { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 4px; }
  .artifact-heading strong { overflow: hidden; color: #34404a; font-family: var(--font-mono); font-size: 8px; font-weight: 620; text-overflow: ellipsis; white-space: nowrap; }
  .artifact-heading small { color: #899198; font-size: 7px; }
  .artifact-menu { color: #929aa0; font-size: 9px; letter-spacing: 1px; }
  .code-lines { display: flex; min-height: 115px; flex-direction: column; justify-content: center; gap: 11px; padding: 13px 8px; color: #59646d; font-family: var(--font-mono); font-size: 7.7px; white-space: nowrap; }
  .code-lines div { overflow: hidden; text-overflow: ellipsis; }
  .code-lines i { display: inline-block; width: 23px; padding-right: 7px; color: #a8afb3; font-style: normal; text-align: right; }
  .code-purple { color: #7059ca; }
  .code-green { color: #17865c; }
  .code-muted { color: #9aa2a7; }
  .artifact-foot { display: flex; min-height: 32px; align-items: center; justify-content: space-between; gap: 7px; padding-inline: 10px; border-top: 1px solid #eef0ef; color: #637068; font-size: 7px; }
  .artifact-foot span { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .artifact-foot code { color: #87918d; font-family: var(--font-mono); font-size: 6px; }
  .status-dot { width: 5px; height: 5px; border-radius: 50%; background: #c28a2d; }
  .event-card { padding: 12px 10px 4px; }
  .event-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; color: #3b454c; font-size: 8px; font-weight: 660; }
  .event-live { display: inline-flex; align-items: center; gap: 4px; color: #8b9295; font-size: 6px; font-weight: 650; letter-spacing: .06em; }
  .event-live b { width: 4px; height: 4px; border-radius: 50%; background: #8b80ef; }
  .event-item { position: relative; display: flex; align-items: flex-start; gap: 7px; min-height: 43px; }
  .event-item:not(:last-child)::after { position: absolute; top: 20px; left: 9px; width: 1px; height: 24px; background: #e2e6e5; content: ""; }
  .event-mark { z-index: 1; display: grid; width: 18px; height: 18px; flex: 0 0 18px; place-items: center; border: 1px solid #dce1e1; border-radius: 50%; background: #fff; color: #9da4a7; font-family: var(--font-mono); font-size: 7px; }
  .event-mark.done { border-color: #c5e1d4; background: #f0f8f4; color: #168057; }
  .event-mark.active { border-color: #bcb6fa; background: #f2f0ff; color: #5d53de; font-size: 17px; line-height: 1; }
  .event-item div { display: flex; min-width: 0; flex-direction: column; gap: 4px; padding-top: 2px; }
  .event-item strong { color: #46515a; font-size: 7px; font-weight: 600; }
  .event-item small { color: #8a9297; font-size: 6.5px; line-height: 1.35; }
  .event-item.future strong { color: #858e93; font-weight: 520; }
  .preview-caption { display: flex; justify-content: space-between; padding: 10px 20px 11px; border-top: 1px solid #eef0ef; color: #899197; font-family: var(--font-mono); font-size: 7px; letter-spacing: .025em; }
  .status-band { border-block: 1px solid #e1e5e3; background: #fff; }
  .status-inner { display: flex; min-height: 68px; align-items: center; gap: 18px; color: #657078; font-size: 10px; }
  .status-label { display: inline-flex; align-items: center; gap: 7px; color: #3b474f; font-size: 9px; font-weight: 720; letter-spacing: .07em; white-space: nowrap; }
  .status-label .status-dot { width: 6px; height: 6px; background: #b58130; }
  .status-divider { width: 1px; height: 17px; background: #e1e5e4; }
  .status-inner a { margin-left: auto; color: var(--primary); font-weight: 620; text-decoration: none; white-space: nowrap; }
  .status-inner a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .approach { padding-block: 110px 117px; }
  .section-heading { display: grid; grid-template-columns: 1fr .65fr; align-items: end; gap: 70px; margin-bottom: 43px; }
  .section-kicker { margin-bottom: 18px; color: #727c83; font-size: 9px; }
  .section-heading h2,.workflow-intro h2,.closing h2 { margin-bottom: 0; color: var(--foreground); font-size: clamp(34px, 4vw, 46px); font-weight: 620; letter-spacing: -.055em; line-height: 1.1; }
  .section-heading > p { max-width: 440px; margin-bottom: 2px; color: #67717a; font-size: 14px; line-height: 1.8; }
  .principles-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  .principle-card { display: flex; min-height: 315px; flex-direction: column; padding: 23px 24px 19px; border: 1px solid #dfe4e3; border-radius: 12px; background: #fff; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .principle-card:hover { transform: translateY(-3px); border-color: #c7c3ff; box-shadow: 0 10px 30px rgb(20 30 39 / 5%); }
  .principle-number { display: flex; align-items: center; justify-content: space-between; color: #929ba0; font-family: var(--font-mono); font-size: 9px; }
  .principle-number span { font-size: 13px; }
  .principle-icon { position: relative; display: flex; width: 43px; height: 43px; align-items: center; justify-content: center; gap: 4px; margin-block: 25px 24px; border: 1px solid #e8e8fa; border-radius: 12px; background: #f4f3ff; }
  .scope-icon span { width: 5px; border-radius: 4px; background: #685fe2; }
  .scope-icon span:nth-child(1) { height: 12px; opacity: .55; }
  .scope-icon span:nth-child(2) { height: 19px; }
  .scope-icon span:nth-child(3) { height: 15px; opacity: .75; }
  .trail-icon { flex-direction: column; gap: 3px; }
  .trail-icon span { width: 19px; height: 2px; border-radius: 2px; background: #675de0; }
  .trail-icon span:nth-child(2) { width: 14px; align-self: flex-start; margin-left: 12px; opacity: .7; }
  .trail-icon span:nth-child(3) { width: 16px; align-self: flex-start; margin-left: 12px; opacity: .48; }
  .trail-icon span:nth-child(4) { width: 11px; align-self: flex-start; margin-left: 12px; opacity: .33; }
  .review-icon { gap: 0; }
  .review-check { z-index: 1; display: grid; width: 20px; height: 20px; place-items: center; border-radius: 7px; background: #137a54; color: white; font-size: 12px; }
  .review-icon span:last-child { width: 18px; height: 18px; margin-left: -5px; border: 1px solid #9acdb5; border-radius: 7px; }
  .principle-card h3 { margin-bottom: 10px; color: #202a32; font-size: 16px; font-weight: 650; letter-spacing: -.02em; }
  .principle-card p { max-width: 300px; margin-bottom: 23px; color: #69737b; font-size: 12px; line-height: 1.75; }
