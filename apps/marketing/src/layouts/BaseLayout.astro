---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Harnessa — agentic engineering, kept in the loop",
  description = "A workspace in development for teams who want agent work to stay scoped, observable, and reviewable.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f6f4" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
