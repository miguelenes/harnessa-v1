# Copy to .env and replace placeholders locally. Do not commit secrets.
POSTGRES_USER=harnessa
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_DB=harnessa
DATABASE_URL=postgresql+asyncpg://harnessa:replace-with-local-secret@db:5432/harnessa
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-one-time-random-token
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
REPOSITORY_TARGETS=team/service-a,team/service-b
APP_ENV=development
API_PORT=8010
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
MAX_CONCURRENT_RUNS=4
RUN_LEASE_SECONDS=30
RUN_HEARTBEAT_SECONDS=10
RUN_MAX_ATTEMPTS=3
RUN_MAX_WALL_SECONDS=1800
EVENT_RETENTION_DAYS=30
EVENT_REPLAY_LIMIT=500
REDIS_STREAM_MAXLEN=10000
MODEL_GATEWAY_URL=http://litellm:4000
MODEL_MAX_ATTEMPTS=3
MODEL_HTTP_TIMEOUT_SECONDS=60
MODEL_COOLDOWN_SECONDS=30
MODEL_MAX_RETRY_AFTER_SECONDS=15
MODEL_RESERVATION_LEASE_SECONDS=180
MODEL_INTERACTIVE_CONCURRENCY=4
MODEL_INTERACTIVE_RESERVE=2
MODEL_PROBE_OVERFLOW_LIMIT=0
# Provider key values are only forwarded to the LiteLLM service by Compose.
# Replace these placeholders locally if the provider routes are configured.
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
GOOGLE_API_KEY=replace-with-google-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
GROQ_API_KEY=replace-with-groq-key
OPENROUTER_API_KEY=replace-with-openrouter-key
