# Copy to .env and replace placeholders locally. Do not commit secrets.
POSTGRES_USER=harnessa
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_DB=harnessa
DATABASE_URL=postgresql+asyncpg://harnessa:replace-with-local-secret@db:5432/harnessa
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-one-time-random-token
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
REPOSITORY_TARGETS=team/service-a,team/service-b
APP_ENV=development
API_PORT=8010
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
MAX_CONCURRENT_RUNS=4
RUN_LEASE_SECONDS=30
RUN_HEARTBEAT_SECONDS=10
RUN_MAX_ATTEMPTS=3
RUN_MAX_WALL_SECONDS=1800
VERIFICATION_WORKSPACE_LIMIT_BYTES=1073741824
EVENT_RETENTION_DAYS=30
EVENT_REPLAY_LIMIT=500
REDIS_STREAM_MAXLEN=10000
MODEL_GATEWAY_URL=http://litellm:4000
MODEL_MAX_ATTEMPTS=3
MODEL_HTTP_TIMEOUT_SECONDS=60
MODEL_COOLDOWN_SECONDS=30
MODEL_MAX_RETRY_AFTER_SECONDS=15
MODEL_RESERVATION_LEASE_SECONDS=180
MODEL_INTERACTIVE_CONCURRENCY=4
MODEL_INTERACTIVE_RESERVE=2
MODEL_PROBE_OVERFLOW_LIMIT=0
# Optional repository-scoped OpenSpec interview workspaces. Map configured
# repository target IDs to trusted local Git checkout roots; never use user input.
OPENSPEC_REPOSITORY_SOURCES_JSON={}
OPENSPEC_WORKSPACE_ROOT=/var/lib/harnessa/specifications
OPENSPEC_NODE_PATH=
OPENSPEC_CLI_TIMEOUT_SECONDS=20
OPENSPEC_MODEL_ALIAS=
OPENSPEC_MODEL_MAX_OUTPUT_TOKENS=4096
OPENSPEC_REQUIRE_SIGNOFF=false
# Optional retrieval/MCP configuration. Keep tool endpoints deployment-owned,
# and put credentials in the environment named by a secret reference.
MCP_SERVERS_JSON={}
MCP_SECRET_REFERENCES_JSON={}
MCP_READ_ONLY_TOOLS_JSON={}
RETRIEVAL_APPROVED_SKILL_PATHS_JSON={}
# Optional GitHub App integration. Store private key and webhook secret values in
# deployment environment variables and map opaque DB references to those names.
GITHUB_SECRET_REFERENCES_JSON={}
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT_SECONDS=10
GITHUB_WEBHOOK_MAX_BYTES=262144
GITHUB_WEBHOOK_MAX_ATTEMPTS=12
# Optional Qdrant service is started with the retrieval Compose profile. Vector
# querying stays unavailable until a budgeted embedding route is implemented.
QDRANT_PORT=6333
# Optional host-side ACP runner settings. The Compose worker has no Podman
# socket or engine access. The scoped ModelRouter broker is disabled by default;
# no provider key is passed to an agent.
ACP_EXECUTION_ENABLED=false
ACP_REPOSITORY_SOURCES_JSON={}
ACP_WORKSPACE_ROOT=/var/lib/harnessa/workspaces
ACP_RUNNER_STATE_ROOT=/var/lib/harnessa/runner
ARTIFACT_ROOT=/var/lib/harnessa/artifacts
ACP_AGENT_IMAGE=ghcr.io/anomalyco/opencode:2.0.32@sha256:85986f556e985e377bd24cd68a5ccfbc647bb49e591194edda8a0e4542303319
ACP_CPU_LIMIT=2
ACP_MEMORY_LIMIT_BYTES=2147483648
ACP_PIDS_LIMIT=256
ACP_TMPFS_LIMIT_BYTES=536870912
ACP_WORKSPACE_LIMIT_BYTES=4294967296
ACP_FRAME_LIMIT_BYTES=1048576
ACP_UPDATE_LIMIT=10000
ACP_ARTIFACT_LIMIT_BYTES=10485760
ACP_MODEL_BROKER_ENABLED=false
ACP_MODEL_ALIAS=
ACP_MODEL_MAX_OUTPUT_TOKENS=8192
# Provider key values are only forwarded to the LiteLLM service by Compose.
# Replace these placeholders locally if the provider routes are configured.
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-anthropic-key
GOOGLE_API_KEY=replace-with-google-key
DEEPSEEK_API_KEY=replace-with-deepseek-key
GROQ_API_KEY=replace-with-groq-key
OPENROUTER_API_KEY=replace-with-openrouter-key
